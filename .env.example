# Smart Stock environment defaults
# Defaults are safe for SaaS/private beta: auth enabled, showcase disabled.

# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Future SaaS/auth and beta gate
AUTH_LOGIN_ENABLED=true
BETA_PASSWORD=""
BETA_SECRET=""

# Public showcase mode
# To publish a read-only portfolio demo, set all four values below explicitly.
SHOWCASE_MODE=false
NEXT_PUBLIC_SHOWCASE_MODE=false
SHOWCASE_READONLY=true
DEMO_STORE_ID=""

# Demo/seed escape hatches. Keep disabled in shared/public environments.
ALLOW_DEMO_NO_AUTH=false
ALLOW_DEMO_SEED=false
SEED_DEMO=false

# Optional app integrations
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5"
APP_VERSION="dev"
